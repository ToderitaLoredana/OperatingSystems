diff --git a/Makefile b/Makefile
--- a/Makefile
+++ b/Makefile
@@ -1 +1,2 @@
 UPROGS=\
+	$U/_trace\
diff --git a/kernel/syscall.h b/kernel/syscall.h
--- a/kernel/syscall.h
+++ b/kernel/syscall.h
@@ -1 +1,2 @@
 #define SYS_sync   22
+#define SYS_trace  23
diff --git a/user/user.h b/user/user.h
--- a/user/user.h
+++ b/user/user.h
@@ -1 +1,2 @@
 int sync(void);
+int trace(int);
diff --git a/user/usys.pl b/user/usys.pl
--- a/user/usys.pl
+++ b/user/usys.pl
@@ -1 +1,2 @@
 entry("sync");
+entry("trace");
diff --git a/user/trace.c b/user/trace.c
new file mode 100644
--- /dev/null
+++ b/user/trace.c
@@ -0,0 +1,21 @@
+#include "kernel/types.h"
+#include "kernel/stat.h"
+#include "user/user.h"
+
+int
+main(int argc, char *argv[])
+{
+  if(argc < 3){
+    fprintf(2, "usage: trace mask command [args...]\n");
+    exit(1);
+  }
+
+  if(trace(atoi(argv[1])) < 0){
+    fprintf(2, "trace: failed\n");
+    exit(1);
+  }
+
+  exec(argv[2], argv + 2);
+  fprintf(2, "trace: exec %s failed\n", argv[2]);
+  exit(1);
+}
diff --git a/kernel/proc.h b/kernel/proc.h
--- a/kernel/proc.h
+++ b/kernel/proc.h
@@ -1 +1,2 @@
   int pid;                     // Process ID
+  int trace_mask;              // Bit mask of system calls to trace
diff --git a/kernel/proc.c b/kernel/proc.c
--- a/kernel/proc.c
+++ b/kernel/proc.c
@@ -1 +1,2 @@
   *(np->trapframe) = *(p->trapframe);
+  np->trace_mask = p->trace_mask;
diff --git a/kernel/sysproc.c b/kernel/sysproc.c
--- a/kernel/sysproc.c
+++ b/kernel/sysproc.c
@@ -101,0 +102,8 @@
+uint64
+sys_trace(void)
+{
+  int mask;
+  argint(0, &mask);
+  myproc()->trace_mask = mask;
+  return 0;
+}
diff --git a/kernel/syscall.c b/kernel/syscall.c
--- a/kernel/syscall.c
+++ b/kernel/syscall.c
@@ -1 +1,2 @@
 extern uint64 sys_sync(void);
+extern uint64 sys_trace(void);
@@ -1,2 +1,29 @@
 [SYS_sync]    sys_sync,
+[SYS_trace]   sys_trace,
 };
+
+static char *syscallnames[] = {
+[SYS_fork]    "fork",
+[SYS_exit]    "exit",
+[SYS_wait]    "wait",
+[SYS_pipe]    "pipe",
+[SYS_read]    "read",
+[SYS_kill]    "kill",
+[SYS_exec]    "exec",
+[SYS_fstat]   "fstat",
+[SYS_chdir]   "chdir",
+[SYS_dup]     "dup",
+[SYS_getpid]  "getpid",
+[SYS_sbrk]    "sbrk",
+[SYS_pause]   "pause",
+[SYS_uptime]  "uptime",
+[SYS_open]    "open",
+[SYS_write]   "write",
+[SYS_mknod]   "mknod",
+[SYS_unlink]  "unlink",
+[SYS_link]    "link",
+[SYS_mkdir]   "mkdir",
+[SYS_close]   "close",
+[SYS_sync]    "sync",
+[SYS_trace]   "trace",
+};
@@ -1 +1,4 @@
     p->trapframe->a0 = syscalls[num]();
+    if((p->trace_mask >> num) & 1)
+      printf("%d: syscall %s -> %ld\n", p->pid, syscallnames[num],
+             p->trapframe->a0);
